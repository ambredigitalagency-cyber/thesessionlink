# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# graphify knowledge graph (generated cache, rebuild with /graphify)
/graphify-out/

# database dumps
#
# A data dump carries live auth rows — user emails, sessions and refresh
# tokens. Those are credentials, and a repository is the wrong place for them:
# once pushed they are on the remote for good, readable by anyone who can read
# the repo, and they survive every later deletion of the file.
# Take the dumps, keep them off the machine's git, restore from disk.
backup-*.sql
