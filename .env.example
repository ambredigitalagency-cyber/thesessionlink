# --- Supabase -----------------------------------------------------------------
# Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Service role / secret key. Server-side only: public bookings, emails, cron.
SUPABASE_SECRET_KEY=sb_secret_xxx

# --- App ----------------------------------------------------------------------
# Public base URL, used in share links and emails.
NEXT_PUBLIC_SITE_URL=https://thesessionlink.com

# --- Resend -------------------------------------------------------------------
# Optional in development (emails are logged to the console when missing).
RESEND_API_KEY=re_xxx
EMAIL_FROM=TheSessionLink <hello@thesessionlink.com>
EMAIL_REPLY_TO=

# --- Google sign-in (local Supabase only) -------------------------------------
# Read by the Supabase CLI to substitute env(...) in supabase/config.toml, so
# they must be exported in the shell that runs `npm run db:start` — the CLI does
# not read this file. On a hosted project you set the same pair in
# Authentication > Providers > Google instead; the app itself needs no new var.
# Authorised redirect URI to declare in the Google Cloud console:
#   http://127.0.0.1:54421/auth/v1/callback   (local)
#   https://<project-ref>.supabase.co/auth/v1/callback   (hosted)
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# --- Cron ---------------------------------------------------------------------
# Shared secret for /api/cron/reminders (Vercel Cron sends it automatically).
CRON_SECRET=generate-a-long-random-string

# --- Payments (Stripe Connect + PayPal Commerce Platform) ---------------------
# All optional. A provider whose variables are missing is simply not offered:
# the product works exactly as before, and the coach sees "Coming soon" instead
# of a Connect button. Fill them in once the platform accounts exist.
#
# Nothing here ever reaches the browser. The client is only ever redirected to
# a URL our own server asked the provider for.

# Stripe — Dashboard > Developers. Use the test keys until you go live.
# The money is charged directly on the coach's own STANDARD connected account,
# so TheSessionLink never holds funds and takes no commission.
#   Connect client id: Dashboard > Settings > Connect > Integration (ca_…)
#   Webhook endpoint to register (events: checkout.session.completed,
#   checkout.session.async_payment_succeeded, checkout.session.async_payment_failed,
#   checkout.session.expired, account.updated — with "listen to connected accounts" on):
#     https://<your-domain>/api/payments/webhook/stripe
#   Redirect URI to allow-list in Connect settings:
#     https://<your-domain>/api/payments/callback/stripe
STRIPE_SECRET_KEY=
STRIPE_CONNECT_CLIENT_ID=
STRIPE_WEBHOOK_SECRET=

# PayPal — developer.paypal.com, a REST app on a Partner/Commerce Platform account.
#   PAYPAL_PARTNER_ID is the platform's own merchant id (payer id), not the app id.
#   PAYPAL_BN_CODE is the attribution code PayPal gives partners.
#   Webhook to register (events: PAYMENT.CAPTURE.COMPLETED, PAYMENT.CAPTURE.DENIED,
#   PAYMENT.CAPTURE.REFUNDED, CHECKOUT.ORDER.VOIDED, MERCHANT.ONBOARDING.COMPLETED,
#   MERCHANT.PARTNER-CONSENT.REVOKED):
#     https://<your-domain>/api/payments/webhook/paypal
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_PARTNER_ID=
PAYPAL_BN_CODE=
PAYPAL_WEBHOOK_ID=
PAYPAL_ENV=sandbox
