# --- Supabase -----------------------------------------------------------------
# Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Service role / secret key. Server-side only: public requests, emails, cron.
SUPABASE_SECRET_KEY=sb_secret_xxx

# --- App ----------------------------------------------------------------------
# Public base URL, used in share links and emails.
NEXT_PUBLIC_SITE_URL=https://thesessionlink.com

# --- Resend -------------------------------------------------------------------
# Optional in development (emails are logged to the console when missing).
RESEND_API_KEY=re_xxx
EMAIL_FROM=TheSessionLink <hello@thesessionlink.com>
EMAIL_REPLY_TO=

# --- Google sign-in (local Supabase only) -------------------------------------
# Read by the Supabase CLI to substitute env(...) in supabase/config.toml, so
# they must be exported in the shell that runs `npm run db:start` — the CLI does
# not read this file. On a hosted project you set the same pair in
# Authentication > Providers > Google instead; the app itself needs no new var.
# Authorised redirect URI to declare in the Google Cloud console:
#   http://127.0.0.1:54421/auth/v1/callback   (local)
#   https://<project-ref>.supabase.co/auth/v1/callback   (hosted)
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# --- Cron ---------------------------------------------------------------------
# Shared secret for /api/cron/deletion-warnings, called by pg_cron (the value
# stored in Supabase Vault as "cron_secret" must match).
CRON_SECRET=generate-a-long-random-string

# --- Page statistics ----------------------------------------------------------
# Secret key of the daily, anonymous visitor code (HMAC of IP + browser + page +
# day; the IP itself is never stored). Required for statistics to be recorded.
# Generate a long random value once per environment, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TRACKING_SECRET=

# Support on WhatsApp, linked from the landing's footer (international form,
# e.g. +212612345678). Leave empty to hide the link.
SUPPORT_WHATSAPP=

# Console password: opens /admin at /admin/login without a Supabase account.
# Solo/demo use only (see src/lib/admin/password-access.ts). 12 characters
# minimum, otherwise the feature stays off. Changing it logs everyone out.
ADMIN_ACCESS_PASSWORD=

# Paddle Billing — the coach's own subscription to TheSessionLink (Paddle is the
# merchant of record). Sandbox and production are separate worlds: each has its
# own API key, price, webhook secret and client token. See src/lib/billing/paddle.ts.
PADDLE_ENV=sandbox
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_PRICE_ID=
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
