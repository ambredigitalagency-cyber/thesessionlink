# --- Supabase -----------------------------------------------------------------
# Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Service role / secret key. Server-side only: public bookings, emails, cron.
SUPABASE_SECRET_KEY=sb_secret_xxx

# --- App ----------------------------------------------------------------------
# Public base URL, used in share links and emails.
NEXT_PUBLIC_SITE_URL=https://thesessionlink.com

# --- Resend -------------------------------------------------------------------
# Optional in development (emails are logged to the console when missing).
RESEND_API_KEY=re_xxx
EMAIL_FROM=TheSessionLink <hello@thesessionlink.com>
EMAIL_REPLY_TO=

# --- Cron ---------------------------------------------------------------------
# Shared secret for /api/cron/reminders (Vercel Cron sends it automatically).
CRON_SECRET=generate-a-long-random-string
